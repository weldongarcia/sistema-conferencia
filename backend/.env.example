# Copie para backend/.env (não versionado) e preencha os valores.
# Variáveis já definidas no ambiente têm prioridade sobre este arquivo.

# Chave de assinatura do JWT. Obrigatória, mínimo de 32 caracteres.
# Gere uma chave nova, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# URL de conexão do banco. Obrigatória.
# Formato: postgresql://USUARIO:SENHA@HOST:5432/BANCO
DATABASE_URL=
